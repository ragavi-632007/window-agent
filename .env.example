# FixBot Configuration
# Copy this file to .env and fill in your keys.

# AI Provider — primary (gemini is required; groq is optional fast-path)
AI_PROVIDER=gemini

# --- Gemini (required) ---
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq (optional — fast-path for command lookup, intent disambiguation, GitPilot) ---
# Get a key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- LangSmith tracing (optional) ---
# Set LANGSMITH_ENABLED=true to turn on run tracing
# Get a key at: https://smith.langchain.com
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=fixbot

# --- Other providers (unused by default) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ollama (local, no API key required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Safety / runtime
REQUIRE_CONFIRMATION=true
DRY_RUN=false
MAX_COMMAND_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
